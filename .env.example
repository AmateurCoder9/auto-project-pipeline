# Required — Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required — GitHub PAT with repo+admin scope: https://github.com/settings/tokens
PIPELINE_GITHUB_TOKEN=

# Required — Vercel API token: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Required — GitHub username/org that repos will be created under
# No default — must be set explicitly for multi-tenant safety
GITHUB_REPOSITORY_OWNER=

# Required for LinkedIn posting — run: python setup_linkedin.py
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Optional — for expiry warnings (output of setup_linkedin.py)
LINKEDIN_TOKEN_EXPIRES_AT=

# Optional — Gmail backup notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# Optional — set to 'true' to skip all external writes (GitHub, Vercel, LinkedIn)
TEST_MODE=false

# Optional — set to 'true' to run everything EXCEPT the LinkedIn POST
# (useful for contributors testing without spamming a real account)
DRY_RUN=false

# Tunable defaults (usually no need to change)
PLAYWRIGHT_WAIT_MS=2500
VERCEL_POLL_INTERVAL_S=5
VERCEL_POLL_MAX_ATTEMPTS=24
